# Sibyl — esempio di configurazione.
# Copia questo file in `.env` (NON committato) e adatta i percorsi alla tua macchina.
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
# Lo stesso .env è letto sia dal server (server/config.py) sia dall'agente (agent/config.py).

# ===========================================================================
# SERVER MCP — toolchain CodeQL (prerequisiti della macchina, NON inclusi)
# ===========================================================================

# OBBLIGATORIE: senza queste il server si ferma con un errore esplicito.
# Cartella `ql` di un checkout di vscode-codeql-starter.
CODEQL_SEARCH_PATH=/percorso/a/vscode-codeql-starter/ql
# File .qls della suite di sicurezza da eseguire.
CODEQL_SUITE=/percorso/a/vscode-codeql-starter/ql/python/ql/src/codeql-suites/python-security-extended.qls
# Cartella con le query custom *Broad.ql.
CUSTOM_QUERY_DIR=/percorso/a/vscode-codeql-starter/codeql-custom-queries-python

# OPZIONALI (hanno un default).
# Binario CodeQL: percorso completo se non è sul PATH (default: codeql).
#CODEQL_BIN=/percorso/a/codeql/codeql
# Trasporto del server: stdio | sse | streamable-http (default: stdio).
#   Per l'agente serve la modalità di rete: avvia il server con MCP_TRANSPORT=sse.
#MCP_TRANSPORT=sse
#MCP_HOST=0.0.0.0
#MCP_PORT=8000
# Timeout (secondi) per ogni comando CodeQL (default: 1800).
#CODEQL_TIMEOUT=1800
# Verbosità log del server: DEBUG | INFO | WARNING | ERROR (default: INFO).
#SIBYL_LOG_LEVEL=INFO

# Esempio percorsi Windows (decommenta e adatta se sei su Windows):
#CODEQL_BIN=C:\codeql-tools\codeql\codeql.exe
#CODEQL_SEARCH_PATH=C:\codeql-tools\vscode-codeql-starter\ql
#CODEQL_SUITE=C:\codeql-tools\vscode-codeql-starter\ql\python\ql\src\codeql-suites\python-security-extended.qls
#CUSTOM_QUERY_DIR=C:\codeql-tools\vscode-codeql-starter\codeql-custom-queries-python

# ===========================================================================
# AGENTE — provider LLM e connessione ai servizi
# ===========================================================================

# Provider LLM: ollama (locale) | gemini (hosted, via API OpenAI-compat).
#AGENT_LLM_PROVIDER=ollama

# --- Provider: Ollama (locale) ---
# Modello Ollama da usare (deve risultare in `ollama list`).
AGENT_MODEL=qwen2.5-coder:3b
# Indirizzo di Ollama (default: http://localhost:11434).
#OLLAMA_HOST=http://localhost:11434

# --- Provider: Gemini (hosted) ---
# ATTENZIONE: serve una API key da Google AI Studio (https://aistudio.google.com/apikey),
# NON l'abbonamento dell'app Gemini. Esiste un free tier.
#AGENT_LLM_PROVIDER=gemini
#GEMINI_API_KEY=la-tua-api-key
#GEMINI_MODEL=gemini-2.5-flash          # oppure gemini-2.5-pro
# Distanzia le richieste per restare sotto il rate limit (0 = off).
# Free tier 5 req/min -> 13 ; 15 req/min -> 5.
#GEMINI_MIN_INTERVAL=13
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# URL SSE del server MCP (default: http://127.0.0.1:8000/sse).
#MCP_SERVER_URL=http://127.0.0.1:8000/sse
# Dove salvare checkpoint e report (default: agent/_work e agent/reports).
#AGENT_WORK_DIR=agent/_work
#AGENT_REPORTS_DIR=agent/reports
