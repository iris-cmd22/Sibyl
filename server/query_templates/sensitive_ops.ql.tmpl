/**
 * @name Sensitive operations inventory
 * @description CWE-agnostic inventory of security-sensitive operations, surfaced
 *              REGARDLESS of data flow. It exists so a small model does not have to
 *              notice non-flow issues (weak crypto/hash, weak randomness, insecure
 *              config flags, command/code execution, deserialization) on its own.
 *              Each result carries a structural `kind`, never a CWE.
 * @kind problem
 * @problem.severity recommendation
 * @security-severity 1.0
 * @id py/sensitive-ops-inventory{{CWE_ID_SUFFIX}}
 * @tags security{{CWE_TAG_LINE}}
 */

import python
import semmle.python.Concepts
import semmle.python.dataflow.new.DataFlow

/** A call whose attribute name (obj.NAME(...)) or bare name (NAME(...)) is in `names`. */
bindingset[names]
private predicate callNameIn(DataFlow::CallCfgNode call, string names) {
  call.getFunction().(DataFlow::AttrRead).getAttributeName() = names
  or
  call.getFunction().asExpr().(Name).getId() = names
}

/** A security-sensitive operation `node`, tagged with a structural `kind` (no CWE). */
predicate sensitive(DataFlow::Node node, string kind) {
  // --- CodeQL Concepts (library-modelled dangerous operations) ---
  node instanceof SystemCommandExecution and kind = "command-exec"
  or
  node instanceof CodeExecution and kind = "code-exec"
  or
  node instanceof SqlExecution and kind = "sql-exec"
  or
  node instanceof FileSystemAccess and kind = "filesystem"
  or
  node instanceof Decoding and kind = "decoding"
  or
  // --- crypto via the CodeQL SEMANTIC model (Cryptography::CryptographicOperation):
  //     resolves hashlib / cryptography / Cryptodome imports & aliases, NOT name
  //     matching. Any crypto op (weak or strong): the weak/strong judgement is left
  //     to Validation, so the inventory stays CWE-agnostic. ---
  node instanceof Cryptography::CryptographicOperation and kind = "crypto"
  or
  // --- name-based FALLBACK, only for what CodeQL does NOT model as a Concept
  //     (notably insecure randomness): a small curated list of call names. ---
  exists(DataFlow::CallCfgNode call |
    callNameIn(call, [{{WEAK_CALL_NAMES}}])
  |
    node = call and kind = "weak-call"
  )
  or
  // --- insecure config flags: a call passing one of these kwargs as a literal ---
  exists(DataFlow::CallCfgNode call, string p |
    p = [{{FLAG_PARAM_NAMES}}] and
    call.getArgByName(p).asExpr() instanceof ImmutableLiteral
  |
    node = call and kind = "config-flag"
  )
}

from DataFlow::Node node, string kind
where sensitive(node, kind)
select node, kind
